#!/usr/bin/env bash
# Example: git config alias.stage-check '!tool/hooks/pre-stage "$@"'
set -euo pipefail

original_dir=$(pwd)
trap 'cd "${original_dir}" || true' EXIT

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

go test ./tool/...
go run ./tool/cmd/import
go run ./tool/cmd/catalog

dart format ./..

flutter pub get
flutter analyze --no-pub
flutter test --no-pub

git add "$@"